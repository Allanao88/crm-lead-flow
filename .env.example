# Configurações do Supabase (obrigatórias)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sua-chave-publica-aqui

# Personalização por cliente (todas opcionais, configuráveis na Vercel ou ambiente de build)
# Nome fantasia do cliente (padrão: "Sua empresa")
VITE_CLIENT_NAME=Empresa Modelo

# URL pública (HTTPS obrigatório) da logo do cliente (se ausente ou inválida, exibe as iniciais)
VITE_CLIENT_LOGO_URL=https://exemplo.com.br/logo.png

# Cor primária da marca em formato hexadecimal #RRGGBB (padrão do LeadFlow se ausente ou inválido)
VITE_BRAND_COLOR=#007a29

# E-mail de suporte ou contato comercial do cliente (opcional)
VITE_CONTACT_EMAIL=suporte@exemplo.com.br
